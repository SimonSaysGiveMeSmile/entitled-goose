name: Release builds

# Builds the Windows installer on a real Windows runner when a version tag is
# pushed, and attaches it to that tag's release. macOS DMGs are intentionally
# NOT built here: local builds are Developer-ID signed, and an unsigned CI
# build must never clobber them.

on:
  push:
    tags: ['v*']

permissions:
  contents: write

jobs:
  windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm ci
      - run: npx electron-builder --win --publish never
      - name: Upload installer to the tag's release
        run: gh release upload ${{ github.ref_name }} "release/Entitled-Goose-win-x64.exe" --clobber
        shell: bash
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
